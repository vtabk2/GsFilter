<?xml version="1.0" encoding="utf-8"?>
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:ellipsize="end"
    android:focusable="true"
    android:gravity="center"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:minWidth="@dimen/gs_filter_chip_min_width"
    android:minHeight="@dimen/gs_filter_chip_min_height"
    android:paddingStart="@dimen/gs_filter_chip_horizontal_padding"
    android:paddingTop="@dimen/gs_filter_chip_vertical_padding"
    android:paddingEnd="@dimen/gs_filter_chip_horizontal_padding"
    android:paddingBottom="@dimen/gs_filter_chip_vertical_padding"
    android:textSize="14sp"/>
