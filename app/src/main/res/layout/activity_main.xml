<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_preview"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <ImageView
                    android:id="@+id/imageOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/preview_height"
                    android:layout_marginTop="@dimen/item_spacing"
                    android:adjustViewBounds="true"
                    android:background="@color/preview_background"
                    android:scaleType="fitCenter"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/item_spacing"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/result_preview"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/preview_height"
                    android:layout_marginTop="@dimen/item_spacing"
                    android:background="@color/preview_background">

                    <com.gsfilter.filter.FilterPreviewView
                        android:id="@+id/filterPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_spacing"
            android:textColor="@android:color/holo_red_dark"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_filter_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="@dimen/filter_chip_min_height"
                android:paddingHorizontal="@dimen/filter_chip_horizontal_padding"
                android:paddingVertical="@dimen/filter_chip_vertical_padding"
                android:text="@string/section_filter"
                android:textColor="@android:color/white"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tabAdjust"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/item_spacing"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="@dimen/filter_chip_min_height"
                android:paddingHorizontal="@dimen/filter_chip_horizontal_padding"
                android:paddingVertical="@dimen/filter_chip_vertical_padding"
                android:text="@string/section_adjust"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/filterPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_spacing"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonOriginalFilter"
                    android:layout_width="@dimen/filter_chip_min_height"
                    android:layout_height="@dimen/filter_chip_min_height"
                    android:background="@drawable/bg_filter_chip"
                    android:padding="@dimen/filter_none_icon_padding"
                    android:scaleType="center"
                    android:src="@drawable/ic_filter_none"/>

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_spacing"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/categoryContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/filterScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_spacing"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filterContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/adjustPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_spacing"
            android:orientation="vertical"
            android:padding="@dimen/adjust_panel_padding"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonResetAdjust"
                    android:layout_width="@dimen/adjust_reset_size"
                    android:layout_height="@dimen/adjust_reset_size"
                    android:background="@android:color/transparent"
                    android:padding="@dimen/filter_none_icon_padding"
                    android:scaleType="center"
                    android:src="@drawable/ic_adjust_reset"
                    android:tint="@color/adjust_text_primary"/>

                <SeekBar
                    android:id="@+id/adjustSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_spacing"
                    android:layout_marginEnd="@dimen/item_spacing"
                    android:layout_weight="1"
                    android:progressBackgroundTint="@color/adjust_track_background"
                    android:progressTint="@color/filter_selected"
                    android:thumbTint="@color/adjust_text_primary"/>

                <TextView
                    android:id="@+id/adjustValueText"
                    android:layout_width="@dimen/adjust_value_width"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/adjust_text_primary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_spacing"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/adjustContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

            <Button
                android:id="@+id/buttonResetAllAdjust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_spacing"
                android:minHeight="@dimen/button_min_height"
                android:text="@string/action_reset_all_adjust"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
