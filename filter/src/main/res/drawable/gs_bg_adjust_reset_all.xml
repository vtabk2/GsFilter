<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D2E3FC"/>
            <stroke android:width="1dp" android:color="@color/gs_filter_selected"/>
            <corners android:radius="30dp"/>
            <padding android:bottom="6dp" android:left="15dp" android:right="15dp" android:top="6dp"/>
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#F1F3F4"/>
            <stroke android:width="1dp" android:color="@color/gs_adjust_track_background"/>
            <corners android:radius="30dp"/>
            <padding android:bottom="6dp" android:left="15dp" android:right="15dp" android:top="6dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8F0FE"/>
            <stroke android:width="1dp" android:color="@color/gs_filter_selected"/>
            <corners android:radius="30dp"/>
            <padding android:bottom="6dp" android:left="15dp" android:right="15dp" android:top="6dp"/>
        </shape>
    </item>
</selector>
